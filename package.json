{
  "name": "agy-usage",
  "version": "0.0.1",
  "description": "Local context window, model quota, generation speed, and token usage overlay for Antigravity on macOS and Linux",
  "main": "cli.js",
  "bin": {
    "agy-usage": "./cli.js",
    "antigravity-context-viewer": "./cli.js",
    "antigravity-meter": "./cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/StepaniaH/agy-usage.git"
  },
  "homepage": "https://github.com/StepaniaH/agy-usage#readme",
  "bugs": {
    "url": "https://github.com/StepaniaH/agy-usage/issues"
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "install-patch": "node cli.js install",
    "install-meter": "node cli.js install",
    "live": "node cli.js live",
    "status": "node cli.js status",
    "check": "node cli.js check",
    "restore": "node cli.js restore",
    "uninstall-patch": "node cli.js restore",
    "build:renderer": "node scripts/build-renderer.js",
    "pretest": "node scripts/build-renderer.js",
    "test": "node --test meter-safe-edition.test.js meter-core.test.js meter-renderer.test.js meter-quota.test.js meter-storage-proxy.test.js meter-subscription.test.js meter-integration.test.js meter-security-update.test.js meter-cli-launcher.test.js meter-v083-fixes.test.js meter-v085-fixes.test.js meter-hotload.test.js meter-macos-watch.test.js meter-v089-usage.test.js meter-elv91-speed.test.js",
    "format": "npx prettier --write \"*.js\" \"*.json\" \"*.md\"",
    "format:check": "npx prettier --check \"*.js\" \"*.json\" \"*.md\"",
    "pack": "node scripts/package-release.js",
    "package": "node scripts/package-release.js"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "context-viewer",
    "context-window",
    "token-meter",
    "token-tracker",
    "activity-heatmap",
    "progress-bar",
    "electron-patch",
    "gemini",
    "ai-agent"
  ],
  "license": "MIT"
}
